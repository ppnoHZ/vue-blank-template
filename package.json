{
  "name": "with-vite",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "commitlint": "commitlint --edit $1",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "prepare": "npx simple-git-hooks",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@qes/tsconfig": "1.0.2",
    "@types/node": "^24.5.0",
    "lint-staged": "^14.0.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "simple-git-hooks": "^2.11.0",
    "turbo": "^2.5.6"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint",
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "oxlint --fix"
    ],
    "*.{ts,tsx,js,jsx,vue,md,json}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@9.5.0"
}
